diff --git a/kernel/sysinfo.h b/kernel/sysinfo.h
new file mode 100644
index 0000000..95ab474
--- /dev/null
+++ b/kernel/sysinfo.h
@@ -0,0 +1,5 @@
+// Lab 10 optional: what the sysinfo system call fills in.
+struct sysinfo {
+  uint64 freemem;   // free memory, in bytes
+  uint64 nproc;     // processes in use
+};
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index f3b5d40..54a8aa8 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -6,6 +6,7 @@
 #include "spinlock.h"
 #include "proc.h"
 #include "vm.h"
+#include "sysinfo.h"
 
 uint64
 sys_exit(void)
@@ -119,3 +120,19 @@ sys_trace(void)
   myproc()->trace_mask = mask;
   return 0;
 }
+
+// Lab 10 optional: fill a struct sysinfo in the caller's memory.
+uint64
+sys_sysinfo(void)
+{
+  uint64 addr;               // argument 0: user address of a struct sysinfo
+  struct sysinfo info;
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  info.freemem = freemem();
+  info.nproc = nproc();
+  if (copyout(p->pagetable, p->sz, addr, (char *)&info, sizeof(info)) < 0)
+    return -1;
+  return 0;
+}
diff --git a/user/sysinfo.c b/user/sysinfo.c
new file mode 100644
index 0000000..cad454b
--- /dev/null
+++ b/user/sysinfo.c
@@ -0,0 +1,20 @@
+#include "kernel/types.h"
+#include "kernel/sysinfo.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  struct sysinfo info;
+
+  if (sysinfo(&info) < 0) {
+    fprintf(2, "sysinfo: failed\n");
+    exit(1);
+  }
+  printf("free memory: %lu bytes (%lu pages)\n", info.freemem, info.freemem / 4096);
+  printf("processes in use: %lu\n", info.nproc);
+
+  // an address the process does not own must give -1, not crash the kernel
+  printf("with a bad pointer sysinfo returns %d\n", sysinfo((struct sysinfo *)0xffffffffffUL));
+  exit(0);
+}
