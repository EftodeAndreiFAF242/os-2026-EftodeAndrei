From 2716449f2906cf3c02c7e1bd5c65774f5d15f6de Mon Sep 17 00:00:00 2001
From: Eftode Andrei <andrei.eftode@isa.utm.md>
Date: Sun, 22 Nov 2026 12:22:23 +0000
Subject: [PATCH 06/14] Lab 13: mix, two processes on one screen

---
 user/mix.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 user/mix.c

diff --git a/user/mix.c b/user/mix.c
new file mode 100644
index 0000000..bb9aa30
--- /dev/null
+++ b/user/mix.c
@@ -0,0 +1,32 @@
+// mix.c: two processes print five lines each, one letter per write().
+//   mix        no lock: the letters of the two processes can mix
+//   mix lock   semaphore 3 used as a lock: every line stays whole
+#include "kernel/types.h"
+#include "user/user.h"
+
+void
+lines(char *s, int uselock)
+{
+  for (int k = 0; k < 5; k++) {
+    if (uselock)
+      sem_down(3);
+    for (char *p = s; *p; p++)
+      write(1, p, 1);
+    if (uselock)
+      sem_up(3);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int uselock = (argc > 1);
+  sem_init(3, 1);
+  if (fork() == 0) {
+    lines("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", uselock);
+    exit(0);
+  }
+  lines("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n", uselock);
+  wait(0);
+  exit(0);
+}
-- 
