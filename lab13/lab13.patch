From fd3075cd3f9fe82be58284b046e6aa2a94a04951 Mon Sep 17 00:00:00 2001
From: Eftode Andrei <andrei.eftode@isa.utm.md>
Date: Sun, 22 Nov 2026 12:22:23 +0000
Subject: [PATCH 05/14] Lab 13: semtest, order and ping-pong tests

---
 user/semtest.c | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)
 create mode 100644 user/semtest.c

diff --git a/user/semtest.c b/user/semtest.c
new file mode 100644
index 0000000..684dec0
--- /dev/null
+++ b/user/semtest.c
@@ -0,0 +1,39 @@
+// semtest.c: two tests for the kernel semaphores (Lab 12).
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  // Test 1: order. Semaphore 0 starts at 0, so the child must wait.
+  sem_init(0, 0);
+  if (fork() == 0) {
+    sem_down(0);
+    printf("child: I ran after the parent\n");
+    exit(0);
+  }
+  pause(10);
+  printf("parent: done, I let the child go\n");
+  sem_up(0);
+  wait(0);
+
+  // Test 2: ping-pong. Semaphore 1 = ping's turn, semaphore 2 = pong's turn.
+  sem_init(1, 1);
+  sem_init(2, 0);
+  if (fork() == 0) {
+    for (int i = 1; i <= 3; i++) {
+      sem_down(2);
+      printf("  pong %d\n", i);
+      sem_up(1);
+    }
+    exit(0);
+  }
+  for (int i = 1; i <= 3; i++) {
+    sem_down(1);
+    printf("ping %d\n", i);
+    sem_up(2);
+  }
+  wait(0);
+  printf("semtest: OK\n");
+  exit(0);
+}
-- 
