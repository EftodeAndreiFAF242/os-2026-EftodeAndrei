From 9b7b5a096a9b3fe0bd1b47e8ad275ef506a1995c Mon Sep 17 00:00:00 2001
From: Eftode Andrei <andrei.eftode@isa.utm.md>
Date: Sun, 22 Nov 2026 12:25:14 +0000
Subject: [PATCH 08/14] Lab 13: kernel/sem.c, the three semaphore calls

---
 kernel/sem.c | 77 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 77 insertions(+)
 create mode 100644 kernel/sem.c

diff --git a/kernel/sem.c b/kernel/sem.c
new file mode 100644
index 0000000..5317d69
--- /dev/null
+++ b/kernel/sem.c
@@ -0,0 +1,77 @@
+// sem.c: counting semaphores inside the xv6 kernel (Lab 12).
+// A small table of NSEM semaphores, shared by every process.
+// Each one is a number plus a spinlock that protects the number.
+
+#include "types.h"
+#include "riscv.h"
+#include "defs.h"
+#include "param.h"
+#include "spinlock.h"
+#include "proc.h"
+
+#define NSEM 8
+
+struct sem {
+  struct spinlock lock;   // a zeroed spinlock is a free spinlock
+  int value;              // how many may still pass
+};
+
+static struct sem sems[NSEM];
+
+// sem_init(id, value): give semaphore id its start value.
+uint64
+sys_sem_init(void)
+{
+  int id, value;
+  argint(0, &id);
+  argint(1, &value);
+  if (id < 0 || id >= NSEM || value < 0)
+    return -1;
+  acquire(&sems[id].lock);
+  sems[id].value = value;
+  release(&sems[id].lock);
+  return 0;
+}
+
+// sem_down(id): take one unit; if there is none, sleep until there is.
+uint64
+sys_sem_down(void)
+{
+  int id;
+  argint(0, &id);
+  if (id < 0 || id >= NSEM)
+    return -1;
+  struct sem *s = &sems[id];
+
+  acquire(&s->lock);
+  while (s->value == 0) {
+    sleep_prepare(s);       // I will sleep on the address of s
+    release(&s->lock);      // never sleep holding a spinlock
+    sleep();                // returns at once if sem_up came in between
+    acquire(&s->lock);
+    if (killed(myproc())) { // kill must still work on a waiting process
+      release(&s->lock);
+      return -1;
+    }
+  }
+  s->value--;
+  release(&s->lock);
+  return 0;
+}
+
+// sem_up(id): give one unit back and wake whoever sleeps on s.
+uint64
+sys_sem_up(void)
+{
+  int id;
+  argint(0, &id);
+  if (id < 0 || id >= NSEM)
+    return -1;
+  struct sem *s = &sems[id];
+
+  acquire(&s->lock);
+  s->value++;
+  wakeup(s);
+  release(&s->lock);
+  return 0;
+}
-- 
2.53.0


