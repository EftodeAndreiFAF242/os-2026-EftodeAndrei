From 72733445691cc23727e1485ba82d07d802066c63 Mon Sep 17 00:00:00 2001
From: Eftode Andrei <andrei.eftode@isa.utm.md>
Date: Mon, 23 Nov 2026 14:16:40 +0000
Subject: [PATCH 5/7] Lab 18: thread_switch in assembly

---
 user/uthread_switch.S | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)
 create mode 100644 user/uthread_switch.S

diff --git a/user/uthread_switch.S b/user/uthread_switch.S
new file mode 100644
index 0000000..beb31cb
--- /dev/null
+++ b/user/uthread_switch.S
@@ -0,0 +1,35 @@
+// user/uthread_switch.S
+	.text
+	.globl thread_switch
+thread_switch:
+	sd ra, 0(a0)		# save current thread registers
+	sd sp, 8(a0)
+	sd s0, 16(a0)
+	sd s1, 24(a0)
+	sd s2, 32(a0)
+	sd s3, 40(a0)
+	sd s4, 48(a0)
+	sd s5, 56(a0)
+	sd s6, 64(a0)
+	sd s7, 72(a0)
+	sd s8, 80(a0)
+	sd s9, 88(a0)
+	sd s10, 96(a0)
+	sd s11, 104(a0)
+
+	ld ra, 0(a1)		# load next thread registers
+	ld sp, 8(a1)
+	ld s0, 16(a1)
+	ld s1, 24(a1)
+	ld s2, 32(a1)
+	ld s3, 40(a1)
+	ld s4, 48(a1)
+	ld s5, 56(a1)
+	ld s6, 64(a1)
+	ld s7, 72(a1)
+	ld s8, 80(a1)
+	ld s9, 88(a1)
+	ld s10, 96(a1)
+	ld s11, 104(a1)
+
+	ret			# return into the next thread
-- 
